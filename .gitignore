# Build output for every project, per Directory.Build.props's Output group.
/artifacts/
[Bb]in/
[Oo]bj/

# The SPA build lands in the host's wwwroot so one URL serves both; it is
# produced by `ng build`, never committed.
/src/Admin.Host/wwwroot/

# Angular
/src/Admin.Web/node_modules/
/src/Admin.Web/dist/
/src/Admin.Web/.angular/
/src/Admin.Web/test-results/
/src/Admin.Web/playwright-report/
# ng invoked from the repo root drops cache here, not under Admin.Web.
.angular/

# Per-developer overrides
.claude/settings.local.json
.remember/

# Subagent-driven-development scratch. It carries a nested `*` ignore of
# its own, which git honours and the index does not read, so the exclusion
# has to be stated here to reach both. test_root_ignore_coverage.py holds
# the rule, so that nothing else arrives excluded from the inside only.
.superpowers/

# Everything under .claude/cache/ is machine-local by construction: the index
# SQLite, and the interpreter run-guard.sh remembers, which is a fact about
# this host's PATH. The skill, .mcp.json and .codeindexignore are shared so
# Claude in this clone uses the same map.
.claude/cache/
.claude/skills/codebase-index/.skill_version

# Python — the hooks and their suite under .claude/ are scripts, not a package.
__pycache__/

# /review-branch's proof that it ran, which grok-review.sh requires before it
# reads a missing suggestions.md as a clean pass.
/.grok-review-ran

# /pr scratch, same names as the other two clones.
/pr-body.md
/pr-title.txt
# /review-copilot scratch — body must not cross the parent shell.
/pr-reply.pr
/pr-reply.id
/pr-reply.body

# The user's local task list, kept current by Claude (CLAUDE.md, Working in
# this repo). Local by design: it changes too often to go through a PR.
/TODO.md
