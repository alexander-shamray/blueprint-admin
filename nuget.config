<?xml version="1.0" encoding="utf-8"?>
<!-- Where packages come from. nuget.org serves everything but the assistant's core and adapter, which are
     blueprint-backend's packages on GitHub Packages (AI assistant design §13). GitHub Packages asks for a token even
     for a public package: GITHUB_PACKAGES_TOKEN, a token with read:packages. CI hands it the job's GITHUB_TOKEN; a
     developer, their own (the design spec's Prerequisites). Nothing here holds a credential. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="blueprint-backend" value="https://nuget.pkg.github.com/alexander-shamray/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="blueprint-backend">
      <package pattern="Common.Assistant" />
      <package pattern="Common.Assistant.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <blueprint-backend>
      <add key="Username" value="blueprint-admin" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </blueprint-backend>
  </packageSourceCredentials>
</configuration>
