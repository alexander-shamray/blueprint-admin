          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductSummaryDto": {
        "required": [
          "productId",
          "name",
          "thumbnailUrl",
          "amount",
          "currency",
          "publishedAt",
          "quantityAvailable"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
