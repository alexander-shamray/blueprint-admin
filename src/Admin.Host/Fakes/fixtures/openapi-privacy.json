{
  "openapi": "3.1.1",
  "info": {
    "title": "Privacy.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5105/"
    }
  ],
  "paths": {
    "/v1/privacy/erasure-requests": {
      "post": {
        "tags": [
          "Erasure requests"
        ],
        "operationId": "RaiseErasureRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RaiseErasureRequestCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/privacy/erasure-requests/{requestId}/reissue": {
      "post": {
        "tags": [
          "Erasure requests"
        ],
        "operationId": "ReissueErasureRequest",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueErasureRequestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/v1/privacy/erasure-requests/{requestId}": {
      "get": {
        "tags": [
          "Erasure requests"
        ],
        "operationId": "GetErasureRequest",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RaiseErasureRequestCommand": {
        "required": [
          "subjectId"
        ],
        "type": "object",
        "properties": {
          "subjectId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReissueErasureRequestRequest": {
        "required": [
          "commandId"
        ],
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Erasure requests"
    }
  ]
}
