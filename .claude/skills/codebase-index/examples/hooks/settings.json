{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/refresh-index.sh\" >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
