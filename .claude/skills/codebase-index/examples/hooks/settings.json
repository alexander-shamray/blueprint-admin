{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CBX_NO_SKILL_AUTO_UPDATE=1 codebase-index update >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
