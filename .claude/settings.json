{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "120000",
    "CBX_NO_SKILL_AUTO_UPDATE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(bash .claude/scripts/git-push-force.sh:*)",
      "Bash(bash .claude/scripts/git-branch-drop.sh:*)",
      "Bash(bash .claude/scripts/git-stage-hunks.sh:*)",
      "Bash(py -3.12 .claude/scripts/sync_pr.py:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks start:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks state:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks done:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks back:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks place:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks sync:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks reconcile)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks rewrite:*)",
      "Bash(py -3.12 .claude/scripts/dispatch_board.py tasks init)",
      "Bash(bash .claude/scripts/git-worktree-sync.sh:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(comm:*)",
      "Grep",
      "Glob",
      "Read",
      "Bash(bash .claude/scripts/host-checks.sh:*)",
      "Bash(bash .claude/scripts/spa-ci.sh)",
      "Bash(bash .claude/scripts/harness-checks.sh:*)",
      "Bash(bash .claude/scripts/npm-checks.sh:*)"
    ],
    "deny": [
      "Edit(.remember/**)",
      "Edit(./.remember/**)",
      "Edit(.claude/scripts/**)",
      "Edit(./.claude/scripts/**)",
      "Edit(.claude/commands/**)",
      "Edit(./.claude/commands/**)",
      "Edit(.claude/agents/**)",
      "Edit(./.claude/agents/**)",
      "Edit(.claude/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(.claude/skills/**)",
      "Edit(./.claude/skills/**)",
      "Edit(.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(.git/**)",
      "Edit(./.git/**)",
      "Edit(.git)",
      "Edit(./.git)",
      "Edit(.mcp.json)",
      "Edit(./.mcp.json)",
      "Edit(.codeindexignore)",
      "Edit(./.codeindexignore)",
      "Edit(/.harness/**)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin HEAD:main:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",
      "Bash(git branch --force:*)",
      "Bash(git branch --list *--no-l*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr merge:*)",
      "Bash(git *--output*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--exec*)",
      "Edit(.claude/rules/**)",
      "Edit(./.claude/rules/**)",
      "Edit(.claude/output-styles/**)",
      "Edit(./.claude/output-styles/**)",
      "Edit(CLAUDE.local.md)",
      "Edit(./CLAUDE.local.md)",
      "Edit(Directory.Packages.props)",
      "Edit(./Directory.Packages.props)",
      "Edit(global.json)",
      "Edit(./global.json)",
      "Edit(BlueprintAdmin.slnx)",
      "Edit(./BlueprintAdmin.slnx)",
      "Edit(Directory.Build.targets)",
      "Edit(./Directory.Build.targets)",
      "Edit(Directory.Build.rsp)",
      "Edit(./Directory.Build.rsp)",
      "Edit(Directory.Solution.props)",
      "Edit(./Directory.Solution.props)",
      "Edit(Directory.Solution.targets)",
      "Edit(./Directory.Solution.targets)",
      "Edit(NuGet.Config)",
      "Edit(./NuGet.Config)",
      "Edit(nuget.config)",
      "Edit(./nuget.config)",
      "Edit(NuGet.config)",
      "Edit(./NuGet.config)",
      "Edit(BlueprintAdmin.slnx.targets)",
      "Edit(./BlueprintAdmin.slnx.targets)",
      "Edit(before.BlueprintAdmin.slnx.targets)",
      "Edit(./before.BlueprintAdmin.slnx.targets)",
      "Edit(after.BlueprintAdmin.slnx.targets)",
      "Edit(./after.BlueprintAdmin.slnx.targets)",
      "Edit(**/Directory.Build.*)",
      "Edit(**/Directory.Solution.*)",
      "Edit(**/NuGet.Config)",
      "Edit(**/nuget.config)",
      "Edit(**/NuGet.config)",
      "Edit(**/*.slnx.targets)",
      "Edit(**/Directory.Packages.*)",
      "Edit(**/*.csproj.user)",
      "Edit(**/obj/**)",
      "Edit(MSBuild.rsp)",
      "Edit(./MSBuild.rsp)",
      "Edit(msbuild.rsp)",
      "Edit(./msbuild.rsp)",
      "Edit(**/MSBuild.rsp)",
      "Edit(**/msbuild.rsp)",
      "Edit(**/global.json)",
      "Edit(AGENTS.md)",
      "Edit(./AGENTS.md)",
      "Bash(git *--no-index*)",
      "Edit(.npmrc)",
      "Edit(./.npmrc)",
      "Edit(**/.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-git-argv.py",
            "statusMessage": "checking git argv"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-index-argv.py",
            "statusMessage": "checking index argv"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-helper-argv.py",
            "statusMessage": "checking helper argv"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-sed-crlf.py",
            "statusMessage": "checking sed line endings"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-git-argv.py",
            "statusMessage": "checking git argv"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-edit-target.py",
            "statusMessage": "checking edit target"
          }
        ]
      },
      {
        "matcher": "Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hint-bound.sh\" PreToolUse index-search-hint.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__codebase-index__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 -P -c \"import os, runpy; runpy.run_path(os.environ['CLAUDE_PROJECT_DIR'] + '/.claude/hooks/index-mcp-root.py', run_name='__main__')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 -P -c \"import os, runpy; runpy.run_path(os.environ['CLAUDE_PROJECT_DIR'] + '/.claude/hooks/refresh-index.py', run_name='__main__')\"",
            "timeout": 15,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 -P -c \"import os, runpy; runpy.run_path(os.environ['CLAUDE_PROJECT_DIR'] + '/.claude/hooks/refresh-index.py', run_name='__main__')\"",
            "timeout": 15,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hint-bound.sh\" UserPromptSubmit index-query-hint.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
